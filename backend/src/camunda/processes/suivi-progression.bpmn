<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_suivi"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.4.0">

  <bpmn:process id="suivi-progression" name="Suivi Progression" isExecutable="true">

    <bpmn:startEvent id="StartEvent_1" name="Timer&#10;hebdomadaire">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_1">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/P1W</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_CheckOverdue" name="Vérifier tâches&#10;en retard">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-overdue-tasks" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_UpdateProgression" name="Mettre à jour&#10;progression">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-project-progression" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Retard" name="Retard&#10;détecté ?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Oui</bpmn:outgoing>
      <bpmn:outgoing>Flow_Non</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_SendAlerts" name="Envoyer alertes&#10;retard">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-overdue-alerts" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Oui</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_1" name="Fin">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_Non</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_CheckOverdue" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CheckOverdue" targetRef="Task_UpdateProgression" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_UpdateProgression" targetRef="Gateway_Retard" />
    <bpmn:sequenceFlow id="Flow_Oui" name="Oui" sourceRef="Gateway_Retard" targetRef="Task_SendAlerts">
      <bpmn:conditionExpression>=hasOverdue = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Non" name="Non" sourceRef="Gateway_Retard" targetRef="EndEvent_1">
      <bpmn:conditionExpression>=hasOverdue = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_SendAlerts" targetRef="EndEvent_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="suivi-progression">

      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="138" y="235" width="64" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_CheckOverdue" bpmnElement="Task_CheckOverdue">
        <dc:Bounds x="250" y="170" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_UpdateProgression" bpmnElement="Task_UpdateProgression">
        <dc:Bounds x="430" y="170" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway" bpmnElement="Gateway_Retard" isMarkerVisible="true">
        <dc:Bounds x="615" y="185" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="607" y="148" width="66" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_SendAlerts" bpmnElement="Task_SendAlerts">
        <dc:Bounds x="730" y="100" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_End" bpmnElement="EndEvent_1">
        <dc:Bounds x="922" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="930" y="235" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="188" y="210" /><di:waypoint x="250" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="370" y="210" /><di:waypoint x="430" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="550" y="210" /><di:waypoint x="615" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Oui" bpmnElement="Flow_Oui">
        <di:waypoint x="640" y="185" /><di:waypoint x="640" y="140" /><di:waypoint x="730" y="140" />
        <bpmndi:BPMNLabel><dc:Bounds x="648" y="153" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Non" bpmnElement="Flow_Non">
        <di:waypoint x="665" y="210" /><di:waypoint x="922" y="210" />
        <bpmndi:BPMNLabel><dc:Bounds x="786" y="192" width="22" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="850" y="140" /><di:waypoint x="940" y="140" /><di:waypoint x="940" y="192" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

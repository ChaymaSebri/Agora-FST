<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_rejoindre"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.4.0">

  <bpmn:process id="rejoindre-projet" name="Rejoindre un Projet" isExecutable="true">

    <bpmn:startEvent id="StartEvent_1" name="Étudiant demande&#10;à rejoindre">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_NotifyClub" name="Notifier&#10;le club">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-club-demande" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_ValidateClub" name="Club valide&#10;ou refuse">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="=clubUserId" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Decision" name="Décision&#10;club ?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Accept</bpmn:outgoing>
      <bpmn:outgoing>Flow_Refuse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_AddMember" name="Ajouter étudiant&#10;au projet">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="add-member-to-project" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Accept</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_NotifyRefus" name="Notifier étudiant&#10;du refus">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-student-refus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Refuse</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_1" name="Fin">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_NotifyClub" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_NotifyClub" targetRef="Task_ValidateClub" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ValidateClub" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_Accept" name="Accepté" sourceRef="Gateway_Decision" targetRef="Task_AddMember">
      <bpmn:conditionExpression>=decision = "accepte"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Refuse" name="Refusé" sourceRef="Gateway_Decision" targetRef="Task_NotifyRefus">
      <bpmn:conditionExpression>=decision = "refuse"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_AddMember" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_NotifyRefus" targetRef="EndEvent_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="rejoindre-projet">

      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="130" y="235" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_NotifyClub" bpmnElement="Task_NotifyClub">
        <dc:Bounds x="250" y="170" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_ValidateClub" bpmnElement="Task_ValidateClub">
        <dc:Bounds x="430" y="170" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <dc:Bounds x="615" y="185" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="608" y="148" width="64" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_AddMember" bpmnElement="Task_AddMember">
        <dc:Bounds x="730" y="100" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_NotifyRefus" bpmnElement="Task_NotifyRefus">
        <dc:Bounds x="730" y="260" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_End" bpmnElement="EndEvent_1">
        <dc:Bounds x="922" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="930" y="235" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="188" y="210" /><di:waypoint x="250" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="370" y="210" /><di:waypoint x="430" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="550" y="210" /><di:waypoint x="615" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Accept" bpmnElement="Flow_Accept">
        <di:waypoint x="640" y="185" /><di:waypoint x="640" y="140" /><di:waypoint x="730" y="140" />
        <bpmndi:BPMNLabel><dc:Bounds x="648" y="153" width="44" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Refuse" bpmnElement="Flow_Refuse">
        <di:waypoint x="640" y="235" /><di:waypoint x="640" y="300" /><di:waypoint x="730" y="300" />
        <bpmndi:BPMNLabel><dc:Bounds x="648" y="263" width="37" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="850" y="140" /><di:waypoint x="940" y="140" /><di:waypoint x="940" y="192" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="850" y="300" /><di:waypoint x="940" y="300" /><di:waypoint x="940" y="228" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
